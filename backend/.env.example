# --- Database ---
# Leave unset to use local SQLite (zero setup). Only set this if you're
# specifically running Postgres.
# DATABASE_URL=postgresql://examplot:examplot@localhost:5432/examplot

# --- Auth ---
JWT_SECRET=change-this-to-any-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- LLM ---
# Choose ONE:
#   LLM_PROVIDER=template   -> no AI, deterministic placeholder text (default, zero setup)
#   LLM_PROVIDER=ollama     -> FREE open-source model running locally, no key needed
#                              (run `ollama serve` + `ollama pull llama3.1` first)
#   LLM_PROVIDER=anthropic  -> paid Claude API, requires LLM_API_KEY
LLM_PROVIDER=template
LLM_API_KEY=
LLM_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173
